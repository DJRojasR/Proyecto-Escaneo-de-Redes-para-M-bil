# Copia este archivo como "keystore.properties" (en la misma carpeta) y rellena
# tus datos. Lo usa Gradle para firmar la versión que subes a Google Play.
# Guarda una copia de tu .jks y de estas contraseñas en un lugar seguro:
# si los pierdes, necesitarás pedir a Google un restablecimiento de la llave de subida.

storeFile=llave-subida.jks
storePassword=TU_CONTRASEÑA
keyAlias=subida
keyPassword=TU_CONTRASEÑA
